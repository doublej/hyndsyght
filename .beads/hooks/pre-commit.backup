#!/bin/sh
# Dispatcher: core.hooksPath points every repo at this shared directory, which
# means a repo cannot ship its own .git/hooks/pre-commit. This forwards to a
# repo-local, version-controlled hook when one exists.
#
# Opt in per repo by committing an executable .githooks/pre-commit.
# Repos without that file are unaffected (this exits 0 immediately).
#
# Escape hatch: git commit --no-verify

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
hook="$root/.githooks/pre-commit"

[ -x "$hook" ] || exit 0

cd "$root" || exit 1
exec "$hook"
