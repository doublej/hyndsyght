#!/bin/sh
# Automatically strip AI/vendor attribution from commit messages.
# Portable (BSD + GNU): the $(...) substitution also drops trailing blank lines.

FILTERED=$(grep -viE \
    -e 'Co-Authored-By:.*(Claude|Anthropic|OpenAI|GPT|Copilot|Cursor|noreply@anthropic|noreply@github)' \
    -e '🤖 Generated with' \
    -e 'Generated by (Claude|AI|ChatGPT)' \
    -e 'Claude-Session:' \
    -e 'claude\.ai/code/session' \
    -e '^\[.*Claude.*\]$' \
    "$1")

printf '%s\n' "$FILTERED" > "$1.stripped"

if ! cmp -s "$1" "$1.stripped"; then
    echo "⚠️  Stripped AI attribution from commit message"
    cat "$1.stripped" > "$1"
fi

rm -f "$1.stripped"
exit 0
